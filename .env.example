# ── Bază de date ─────────────────────────────────────────────
# Dev local: npm run db:dev (Postgres 17 în Docker pe portul 5433)
DATABASE_URL=postgresql://vinerys_user:vinerys_pass@localhost:5433/vinerys_dev

# ── Aplicație ────────────────────────────────────────────────
# Subpath la build-time ("/" sau "/crama"); schimbarea cere rebuild
BASE_URL=/crama
# URL-ul public complet, inclusiv basePath
NEXT_PUBLIC_APP_URL=http://localhost:3000/crama
# Originea (fără basePath)
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── AI ───────────────────────────────────────────────────────
# Cheie de criptare pentru API keys salvate în agenți. NU se schimbă după ce există agenți.
AI_CREDENTIALS_SECRET=

# ── Stocare imagini (MinIO / S3) ─────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=vinerys
# Opțional: baza URL-urilor salvate în DB (afișarea trece oricum prin /api/media)
MINIO_PUBLIC_URL=

# ── Email (resetare parolă, verificare email) ────────────────
# Brevo (gratuit, 300/zi): smtp-relay.brevo.com:587, user = login SMTP, pass = cheia SMTP
# Fără SMTP: în dev linkurile apar în consolă; în producție emailurile nu se trimit.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Vinerys <adresa-verificata@exemplu.ro>"

# Logging (REFACTOR-005): debug | info | warn | error; LOG_FORMAT=json forțează JSON și în dev
LOG_LEVEL=
# Prețuri AI pentru costul estimat (AI-013), USD / 1M tokeni: {"model-sau-prefix": [input, output]}
AI_PRICING_JSON=
# Raportare erori (REFACTOR-006): DSN Sentry sau GlitchTip; gol = dezactivat
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# AI găzduit (AI-012): agenții platformei pentru utilizatorii fără chei proprii + cote lunare
PLATFORM_AI_AGENTS=
AI_QUOTA_SCANS=20
AI_QUOTA_TEXT=50
# Cursuri de rezervă dacă BCE nu răspunde (DATA-007): unități pe 1 EUR, ex. {"RON":4.97,"USD":1.08}
FX_RATES_JSON=
