generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// BETTER AUTH - tabele obligatorii
// ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(USER)
  cellarName    String?
  shareId       String?   @unique
  shareEnabled  Boolean   @default(false)
  aiProvider    String?   @default("gemini")
  /// @deprecated SEC-006: golită prin scripts/migrate-legacy-ai-keys.mjs; coloana se șterge după deploy
  aiApiKey      String?
  // Moneda în care se afișează statisticile (DATA-007)
  currency      String    @default("EUR")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  wines         Wine[]
  wineLogs      WineLog[]
  aiAgents      AIAgent[]
  aiUsage       AIUsage[]
  savedFilters  SavedFilter[]
  tastings      Tasting[]


  @@map("user")
}

model AIAgent {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  provider        String
  providerType    String   @default("preset")
  baseUrl         String?
  model           String?
  encryptedApiKey String
  billingType     String   @default("UNKNOWN")
  capabilities    Json?
  metadata        Json?
  enabled         Boolean  @default(true)
  priority        Int      @default(0)
  timeoutMs       Int      @default(20000)
  maxRetries      Int      @default(1)
  weight          Float    @default(1)
  lastStatus      String?
  lastError       String?
  suggestedModel  String?
  lastCheckedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, enabled, priority])
  @@map("ai_agent")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                String  @id @default(cuid())
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ─────────────────────────────────────────
// VINERYS - modele aplicație
// ─────────────────────────────────────────

model Wine {
  id                   String      @id @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Info de bază
  name                 String
  producer             String?
  country              String?
  region               String?
  subregion            String?
  type                 WineType
  color                WineColor?
  vintage              Int?

  // Detalii
  grapeVarieties       String[]
  alcoholPercentage    Float?
  quantity             Int         @default(1)

  // Stocare & preț
  cellarLocation       String?
  purchaseDate         DateTime?
  purchasePrice        Float?
  estimatedValue       Float?
  // DATA-007: moneda prețurilor de mai sus (originală, nu se convertește la salvare)
  currency             String      @default("EUR")

  // Degustare
  rating               Int?        // 1-5
  tastingNotes         String?
  servingTemperature   String?
  foodPairing          String[]
  agingPotential       String?

  // Arome & fereastră de consum
  aromaProfile         String[]
  drinkFrom            Int?
  drinkUntil           Int?

  // Sticlă
  bottleSize           String?     @default("0.75L")
  bottleImageUrl       String?
  labelImageUrl        String?

  // „Ce gătesc cu el?” (HOME-003): răspunsul AI cache-uit, valid cât timp pairingKey e același
  pairing              Json?
  pairingKey           String?

  // Status
  isFavorite           Boolean     @default(false)
  consumptionDate      DateTime?
  status               WineStatus  @default(IN_CELLAR)

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  wineLogs             WineLog[]
  tastings             Tasting[]
  valuations           WineValuation[]

  @@index([userId])
  @@index([type])
  @@index([country])
  @@index([vintage])
  @@index([status])
  // Căutare fuzzy (CELLAR-009): trigrame pe nume și producător; extensia pg_trgm e creată în migrație
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Wine_name_trgm_idx")
  @@index([producer(ops: raw("gin_trgm_ops"))], type: Gin, map: "Wine_producer_trgm_idx")
}


model WineLog {
  id        String   @id @default(cuid())
  wineId    String?   
  wine      Wine?     @relation(fields: [wineId], references: [id], onDelete: SetNull)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    LogAction
  details   Json?     
  createdAt DateTime @default(now())

  @@index([wineId])
  @@index([userId])
  @@index([action])
  @@map("wine_log")
}

// Degustare (DATA-003): mai multe pe vin, cu ocazie, oameni, mâncare, loc, note, poze și arome.
// Legată de Wine acum; când vine Bottle (#30) primește și bottleId. wineName păstrează contextul dacă vinul e șters.
model Tasting {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wineId    String?
  wine      Wine?    @relation(fields: [wineId], references: [id], onDelete: SetNull)
  wineName  String
  tastedAt  DateTime @default(now())
  rating    Int?
  occasion  String?
  people    String[]
  food      String?
  location  String?
  notes     String?
  photoUrls String[]
  aromas    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, tastedAt])
  @@index([wineId])
  @@map("tasting")
}

// Istoricul valorii estimate (CELLAR-008): o înregistrare la fiecare schimbare a valorii unui vin
model WineValuation {
  id         String   @id @default(cuid())
  wineId     String
  wine       Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade)
  userId     String
  value      Float
  currency   String   @default("EUR")
  source     String   @default("manual")
  recordedAt DateTime @default(now())

  @@index([wineId, recordedAt])
  @@index([userId])
  @@map("wine_valuation")
}

// Filtre salvate în Pivniță (CELLAR-009): parametrii din URL, sub un nume
model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  params    Json
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@map("saved_filter")
}

// Cache pentru scanările AI (AI-008): aceeași imagine nu mai costă un apel AI.
// Nu păstrează imaginea, doar hash-ul ei și rezultatul generic (identificare + îmbogățire).
model ScanCache {
  id         String    @id @default(cuid())
  imageHash  String    @unique
  result     Json
  providers  String[]
  confidence Float
  hits       Int       @default(0)
  createdAt  DateTime  @default(now())
  lastHitAt  DateTime?

  @@index([createdAt])
  @@map("scan_cache")
}

// Consum AI per apel (AI-013): tokeni, cost estimat, latență. Agregat în Setări per lună / agent.
model AIUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId      String?
  provider     String
  model        String?
  operation    String
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  latencyMs    Int?
  success      Boolean
  requestId    String?
  // AI-012: "byo" = cheia utilizatorului, "platform" = cheile platformei (intră în cotă)
  source       String   @default("byo")
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([agentId])
  @@index([userId, source, operation, createdAt])
  @@map("ai_usage")
}

// ─────────────────────────────────────────
// ENUM-URI
// ─────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum WineType {
  RED
  WHITE
  ROSE
  SPARKLING
  DESSERT
  FORTIFIED
}

enum WineColor {
  RED
  WHITE
  ROSE
  ORANGE
}

enum WineStatus {
  IN_CELLAR
  CONSUMED
  SOLD
  GIFTED
}

enum LogAction {
  ADDED
  UPDATED
  CONSUMED
  SOLD
  GIFTED
  SCAN_AI
  DELETE
  TASTED
}
